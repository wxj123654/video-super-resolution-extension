{
  "manifest_version": 3,
  "name": "Video GPU Super Resolution",
  "description": "Realtime WebGL/WebGPU super-resolution for HTML5 videos on the current page.",
  "version": "0.1.0",
  "minimum_chrome_version": "113",
  "action": {
    "default_title": "Video GPU Super Resolution",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": [
        "src/upscaler.js",
        "src/upscaler-core.js",
        "src/upscaler-onnx.js",
        "src/upscaler-post.js",
        "src/shaders/ecbsr-post.js",
        "src/shaders/tiny-cnn.js",
        "src/shaders/webgpu.js",
        "src/upscaler-webgl.js",
        "src/upscaler-webgpu.js",
        "src/models/ecbsr_x2_m4c8_y.onnx",
        "src/vendor/onnxruntime/ort.webgpu.min.js",
        "src/vendor/onnxruntime/ort-wasm-simd-threaded.wasm",
        "src/vendor/onnxruntime/ort-wasm-simd-threaded.jsep.wasm",
        "src/vendor/onnxruntime/ort-wasm-simd-threaded.mjs",
        "src/vendor/onnxruntime/ort-wasm-simd-threaded.jsep.mjs",
        "styles/overlay.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
